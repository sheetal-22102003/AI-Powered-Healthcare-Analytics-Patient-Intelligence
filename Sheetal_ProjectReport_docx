def set_heading_style(para, size=14, bold=True, color=(30, 58, 95)):
    run = para.runs[0] if para.runs else para.add_run(para.text)
    run.bold = bold
    run.font.size = Pt(size)
    run.font.color.rgb = RGBColor(*color)


def add_heading(doc, text, level=1, color=(30, 58, 95)):
    heading = doc.add_heading(text, level=level)
    for run in heading.runs:
        run.font.color.rgb = RGBColor(*color)
        if level == 1:
            run.font.size = Pt(18)
        elif level == 2:
            run.font.size = Pt(14)
        else:
            run.font.size = Pt(12)
    return heading


def add_para(doc, text, bold=False, italic=False, size=11, color=None):
    para = doc.add_paragraph()
    run = para.add_run(text)
    run.bold = bold
    run.italic = italic
    run.font.size = Pt(size)
    if color:
        run.font.color.rgb = RGBColor(*color)
    return para


def add_table(doc, headers, rows, style="Table Grid"):
    table = doc.add_table(rows=1 + len(rows), cols=len(headers))
    table.style = style
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
    # Header row
    hdr = table.rows[0].cells
    for i, h in enumerate(headers):
        hdr[i].text = h
        for run in hdr[i].paragraphs[0].runs:
            run.bold = True
            run.font.color.rgb = RGBColor(255, 255, 255)
        # Header background colour
        shading = OxmlElement("w:shd")
        shading.set(qn("w:fill"), "1E3A5F")
        shading.set(qn("w:color"), "auto")
        shading.set(qn("w:val"), "clear")
        hdr[i].paragraphs[0]._element.getparent().getparent().append(shading)
    # Data rows
    for r_idx, row_data in enumerate(rows):
        row_cells = table.rows[r_idx + 1].cells
        for c_idx, val in enumerate(row_data):
            row_cells[c_idx].text = str(val)
    return table


